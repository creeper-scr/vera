# Used by `pnpm dev:play` when repo-root `.env.play.local` is absent.
# Copy: cp services/minecraft/.env.example services/minecraft/.env.local

# Also seeded into Web Companion consciousness via stage-web vite define.
OPENAI_API_KEY=
OPENAI_API_BASEURL=https://api.openai.com/v1/
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o-mini

BOT_USERNAME=vera-bot
BOT_HOSTNAME=127.0.0.1
BOT_PORT=25565
BOT_AUTH=offline
BOT_VERSION=1.21.1

VERA_WS_BASEURL=ws://127.0.0.1:6121/ws
VERA_CLIENT_NAME=minecraft-bot

# Doubao realtime voice (stage-web; exposed to browser)
VITE_VOLCENGINE_APP_ID=
VITE_VOLCENGINE_ACCESS_KEY=
